#################################################
# NETCONF for TessronOS
#################################################
#
# Network Conf
#
$$HOST	___0 cnet 255.255.255.0 0.0.0.0 NETDRV DEVICE=neta
$$DNS
$$DNS
$$GW
#
# Time Server
#
$$NTP	pool.ntp.org
#
# IPv6
#
$$IPV6	on auto
$$IPV6ADDR
$$IPV6GW
$$IPV6DNS
$$IPV6DNS
