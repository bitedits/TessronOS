<serial num="12" sheet="1" rect="276,58,408,88"><f w="3" lo="0" hi="255"/>.<f w="3" lo="0" hi="255"/>.<f w="3" lo="0" hi="255"/>.<f w="3" lo="0" hi="255"/></serial>
