<text sheet="2" x="8" y="80">ＩＰアドレス：</text>
<box num="31" sheet="2" rect="136,58,408,88" off="true"/>
<text sheet="2" x="8" y="114">サブネットマスク：</text>
<box num="32" sheet="2" rect="136,92,408,122" off="true"/>
<text sheet="2" x="8" y="148">ゲートウェイ：</text>
<box num="33" sheet="2" rect="136,126,408,156" off="true"/>
