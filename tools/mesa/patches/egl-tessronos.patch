+_EGLDisplay *
+_eglGetTessronosDisplay(void *native_display, const EGLAttrib *attrib_list)
+{
+   /* the windows are named when a surface is made: no display to name */
+   if (native_display != NULL) {
+      _eglError(EGL_BAD_PARAMETER, "eglGetPlatformDisplay");
+      return NULL;
+   }
+   if (attrib_list != NULL && attrib_list[0] != EGL_NONE) {
+      _eglError(EGL_BAD_ATTRIBUTE, "eglGetPlatformDisplay");
+      return NULL;
+   }
+   return _eglFindDisplay(_EGL_PLATFORM_TESSRONOS, NULL, attrib_list);
+}
