#
# tools/netbsd/cmds.sh compiles these with tic -S into the table of
# libterminfo (compiled_terms.c), as there is no database of terminals.
#
# tessron is the console of TessronOS (application/lterm/lt_vt.c): the
# sequences of a VT100 and of the ANSI standard it takes, eight colours,
# a second screen for the programs that take the whole of it (less, vi),
# and the keys it sends. vt100, xterm and xterm-256color are the same
# terminal by the names programs from elsewhere are given.
#
tessron|TessronOS console,
	am, bce, km, mir, msgr, xenl, npc,
	cols#80, it#8, lines#24, colors#8, pairs#64,
	bel=^G, cr=\r, ht=^I, nel=\r\n, ind=\n, ri=\EM,
	clear=\E[H\E[2J, ed=\E[J, el=\E[K, el1=\E[1K,
	cup=\E[%i%p1%d;%p2%dH, home=\E[H,
	hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
	cuu1=\E[A, cud1=\n, cuf1=\E[C, cub1=^H,
	cuu=\E[%p1%dA, cud=\E[%p1%dB, cuf=\E[%p1%dC, cub=\E[%p1%dD,
	il1=\E[L, il=\E[%p1%dL, dl1=\E[M, dl=\E[%p1%dM,
	ich=\E[%p1%d@, dch1=\E[P, dch=\E[%p1%dP, ech=\E[%p1%dX,
	smir=\E[4h, rmir=\E[4l,
	csr=\E[%i%p1%d;%p2%dr, sc=\E7, rc=\E8,
	tbc=\E[3g, hts=\EH,
	sgr0=\E[m, bold=\E[1m, dim=\E[2m, smul=\E[4m, rmul=\E[24m,
	rev=\E[7m, smso=\E[7m, rmso=\E[27m, blink=\E[5m, invis=\E[8m,
	sitm=\E[3m, ritm=\E[23m,
	setaf=\E[3%p1%dm, setab=\E[4%p1%dm, op=\E[39;49m,
	smcup=\E[?1049h, rmcup=\E[?1049l,
	civis=\E[?25l, cnorm=\E[?25h,
	smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
	kcuu1=\EOA, kcud1=\EOB, kcuf1=\EOC, kcub1=\EOD,
	khome=\EOH, kend=\EOF, kich1=\E[2~, kdch1=\E[3~,
	kpp=\E[5~, knp=\E[6~, kbs=^?, kcbt=\E[Z, kent=\EOM,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
	kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
	kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
	u6=\E[%i%d;%dR, u7=\E[6n,
vt100|the console of TessronOS by the name vt100,
	use=tessron,
xterm|the console of TessronOS by the name xterm,
	use=tessron,
xterm-256color|the console of TessronOS by the name xterm-256color,
	use=tessron,
dumb|a terminal that only writes on,
	am,
	cols#80,
	bel=^G, cr=\r, cud1=\n, ind=\n,
